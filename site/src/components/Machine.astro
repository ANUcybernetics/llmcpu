---
import "../styles/machine.css";
---

<section id="machine" class="machine">
  <div class="toolbar">
    <label class="field">
      <span>What to run</span>
      <select id="program">
        <optgroup label="Things">
          <option id="custom-option" value="custom" hidden>Custom bytes</option>
        </optgroup>
        <optgroup label="RISC-V programs" id="program-group"></optgroup>
      </select>
    </label>
    <details id="feed" class="feed">
      <summary>Feed it anything</summary>
      <div class="feed-body">
        <p class="muted">
          The machine runs whatever is in memory. Paste text or hex, drop any file onto this box, or ask for random
          bytes.
        </p>
        <div class="feed-row">
          <textarea id="feed-text" rows="3" placeholder="Any text, or hex bytes" aria-label="Bytes to load"></textarea>
          <div class="feed-controls">
            <label><input type="radio" name="feed-kind" id="feed-txt" checked /> text</label>
            <label><input type="radio" name="feed-kind" id="feed-hex" /> hex</label>
            <button type="button" id="feed-load">Load these bytes</button>
          </div>
        </div>
        <div class="feed-row">
          <label class="field">
            <span>A file</span>
            <input type="file" id="feed-file" />
          </label>
          <label class="field">
            <span>Random bytes</span>
            <select id="feed-random-size">
              <option value="64">64</option>
              <option value="256" selected>256</option>
              <option value="1024">1024</option>
            </select>
          </label>
          <button type="button" id="feed-random">Load random bytes</button>
        </div>
      </div>
    </details>
    <label class="field">
      <span>Model</span>
      <select id="model">
        <option value="oracle">Perfect oracle (no language model)</option>
      </select>
    </label>
    <button type="button" id="load-model">Load model</button>
    <progress id="model-progress" max="1" hidden></progress>
    <details class="knobs">
      <summary>Knobs</summary>
      <div class="knob-grid">
        <label class="field">
          <span>How to read the bytes</span>
          <select id="knob-reading">
            <option value="free" selected>a language only the model knows</option>
            <option value="blind">RISC-V, from the raw bytes</option>
            <option value="manual">RISC-V, with the manual</option>
            <option value="disasm">RISC-V, with the manual and a decoder</option>
          </select>
        </label>
        <label class="field">
          <span>State shown each step</span>
          <select id="knob-echo">
            <option value="minimal">pc and its four bytes</option>
            <option value="registers" selected>plus non-zero registers</option>
            <option value="full">plus nearby memory and console</option>
          </select>
        </label>
        <label class="field">
          <span>Thinking before acting</span>
          <select id="knob-thinking">
            <option value="off" selected>none</option>
            <option value="short">a few sentences</option>
            <option value="long">a paragraph</option>
          </select>
        </label>
        <label class="field">
          <span>Instructions remembered</span>
          <select id="knob-window">
            <option value="0">none</option>
            <option value="4">4</option>
            <option value="8" selected>8</option>
            <option value="24">24</option>
          </select>
        </label>
      </div>
      <p class="muted">Changes apply from the next instruction.</p>
    </details>
    <label class="field inline compare" id="compare-field" hidden>
      <input type="checkbox" id="compare" />
      <span>Compare with a silicon RISC-V processor</span>
    </label>
  </div>
  <p id="model-note" class="note muted"></p>

  <div class="panes">
    <section id="source-pane" class="pane" aria-labelledby="source-h">
      <h2 id="source-h">Source</h2>
      <ol id="source" class="source mono"></ol>
    </section>
    <section id="asm-pane" class="pane" aria-labelledby="asm-h">
      <h2 id="asm-h">Assembly <span class="muted">as silicon reads it</span></h2>
      <ol id="asm" class="asm mono"></ol>
    </section>
    <section id="text-pane" class="pane" aria-labelledby="text-h">
      <h2 id="text-h">The bytes as text <span class="muted">what the model is reading</span></h2>
      <pre id="text" class="textview mono"></pre>
    </section>
    <section class="pane" aria-labelledby="mem-h">
      <h2 id="mem-h">Memory <span id="image-label" class="muted"></span></h2>
      <ol id="memory" class="memory mono"></ol>
    </section>
  </div>

  <div class="controls">
    <button type="button" id="step" disabled>Step</button>
    <button type="button" id="run" disabled>Run</button>
    <button type="button" id="back" disabled>Back</button>
    <button type="button" id="reset">Reset</button>
    <label class="field inline">
      <span>Pause between instructions</span>
      <select id="pause">
        <option value="0" selected>none</option>
        <option value="500">half a second</option>
        <option value="1000">one second</option>
        <option value="2000">two seconds</option>
      </select>
    </label>
    <button type="button" id="format" aria-pressed="false">Show registers in decimal</button>
    <span id="measures" class="counter"></span>
    <span id="divergence" class="counter"></span>
  </div>
  <p id="status" class="status" role="status" aria-live="polite"></p>

  <p id="latest" class="latest"></p>

  <div id="cpus" class="cpus">
    <section class="cpu model" aria-labelledby="model-h">
      <h2 id="model-h">The model</h2>
      <p class="cpu-line mono">pc <span id="model-pc"></span> <span id="model-status" class="cpu-status"></span></p>
      <div id="model-regs" class="regs mono"></div>
      <div class="devices">
        <output id="model-console" class="console mono" aria-label="Model console"></output>
        <canvas id="model-display" class="display" width="32" height="32" role="img"></canvas>
      </div>
    </section>
    <section id="silicon-cpu" class="cpu silicon" aria-labelledby="silicon-h" hidden>
      <h2 id="silicon-h">Silicon</h2>
      <p class="cpu-line mono">pc <span id="silicon-pc"></span> <span id="silicon-status" class="cpu-status"></span></p>
      <div id="silicon-regs" class="regs mono"></div>
      <div class="devices">
        <output id="silicon-console" class="console mono" aria-label="Silicon console"></output>
        <canvas id="silicon-display" class="display" width="32" height="32" role="img"></canvas>
      </div>
      <p id="silicon-expected" class="muted expected"></p>
    </section>
  </div>

  <section class="trace-section" aria-labelledby="trace-h">
    <h2 id="trace-h">Trace</h2>
    <p id="trace-blurb" class="muted">
      One row per instruction: the bytes the model took as an instruction, what it said they meant, and what it did.
    </p>
    <ol id="trace" class="trace"></ol>
  </section>
</section>

<script>
  import { main } from "../app/main";

  void main();
</script>
