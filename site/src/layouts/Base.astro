---
import "@fontsource-variable/instrument-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { href: `${base}/`, label: "machine", match: base },
  { href: `${base}/about/`, label: "about", match: `${base}/about` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="wordmark mono" href={`${base}/`}>llmcpu</a>
      <nav aria-label="Site">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={here === item.match ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <p class="muted">
        A <a href="https://cybernetics.anu.edu.au">School of Cybernetics</a> experiment. Everything runs in your browser;
        nothing you feed it leaves your machine.
        <a href="https://github.com/ANUcybernetics/llmcpu">Source on GitHub</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    width: min(var(--content-width), 100% - 2 * var(--space-4));
    margin-inline: auto;
    padding-block: var(--space-4);
  }

  .wordmark {
    font-weight: 700;
    font-size: var(--step1);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-4);
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  footer {
    width: min(var(--content-width), 100% - 2 * var(--space-4));
    margin-inline: auto;
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--line);
    font-size: var(--step-1);
  }
</style>
